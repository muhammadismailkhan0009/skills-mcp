{
  "name": "@myriadcodelabs/skills-mcp",
  "version": "0.1.1",
  "description": "A lightweight MCP server for exposing reusable skills from GitHub repositories",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "build": "npm run clean && npm run build:server && npm run build:ui",
    "dev": "npm run build:ui && tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "release:check": "npm run typecheck && npm test && npm run build && npm pack --dry-run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "vite build"
  },
  "keywords": [
    "mcp",
    "skills",
    "agent-skills",
    "model-context-protocol"
  ],
  "author": "Muhammad Ismail Khan",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "skills-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SPECIFICATIONS.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammadismailkhan0009/skills-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/muhammadismailkhan0009/skills-mcp/issues"
  },
  "homepage": "https://github.com/muhammadismailkhan0009/skills-mcp#readme"
}
